APP_NAME="GSC Tool"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── GSC Tool ───────────────────────────────────────────────────────────────
# Rename the tool here; nothing in the code hardcodes the name.
GSCT_NAME="GSC Tool"
GSCT_SLUG=gsc-tool
GSCT_PRIMARY_COLOR="#BA5A00"
GSCT_TIMEZONE=Europe/Amsterdam

# Sign-ups: off while the tool is only for you. Switch on when paid plans go live.
GSCT_REGISTRATION=false
GSCT_SIGNUP_PLAN=starter

# Google service account key (JSON). Keep it OUTSIDE the web root.
GOOGLE_SERVICE_ACCOUNT_JSON=/home/USER/secrets/gsc-tool.json

# OAuth is built in but off; service accounts only for now.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# BigQuery (use EU so Bulk Export and API datasets can be joined)
BIGQUERY_PROJECT=
BIGQUERY_LOCATION=EU
BIGQUERY_API_DATASET=gsc_api
# Hard ceiling per query in bytes (default 50 GiB)
# BIGQUERY_MAX_BYTES_PER_QUERY=53687091200

# Credits: 1 credit = this many bytes billed (default 1 GiB)
# GSCT_BYTES_PER_CREDIT=1073741824
GSCT_QUERY_CACHE_HOURS=24
# GSCT_DAILY_CREDIT_CAP=200

# Two-factor login: off | optional | required. Admin defaults to required (authenticator app).
TWO_FACTOR=optional
TWO_FACTOR_ADMIN=required
TWO_FACTOR_METHODS=app,email
TWO_FACTOR_ADMIN_METHODS=app

# One Google service account per workspace (needs the IAM roles in docs/setup.md). Switch on before sign-ups.
GOOGLE_WORKSPACE_ACCOUNTS=false
